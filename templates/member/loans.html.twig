{% extends 'base.html.twig' %}

{% block title %}Mes emprunts{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="mb-5 text-center">
        <h1 class="display-5 fw-bold mb-3" style="color: #10b981;">
            <i class="bi bi-journal-bookmark-fill"></i> Mes emprunts
        </h1>
        <p class="lead text-muted">Suivez l'état de vos emprunts en cours</p>
    </div>

    {% if loans is empty %}
        <div class="card">
            <div class="card-body text-center py-5">
                <i class="bi bi-inbox" style="font-size: 4rem; color: #ccc;"></i>
                <h3 class="mt-4 mb-2" style="color: #10b981;">Aucun emprunt en cours</h3>
                <p class="text-muted mb-4">Vous n'avez aucun emprunt actif pour le moment.</p>
                <a href="{{ path('member_ouvrages') }}" class="btn btn-primary">
                    <i class="bi bi-search"></i> Parcourir le catalogue
                </a>
            </div>
        </div>
    {% else %}
        <div class="card">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4" style="color: #212529;">Ouvrage</th>
                                <th style="color: #212529;">Exemplaire / Cote</th>
                                <th style="color: #212529;">Emprunté le</th>
                                <th style="color: #212529;">Échéance</th>
                                <th style="color: #212529;">Statut</th>
                                <th class="text-end pe-4" style="color: #212529;">Retour</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for loan in loans %}
                            <tr>
                                <td class="ps-4 fw-bold">
                                    {% if loan.exemplaire and loan.exemplaire.ouvrage %}
                                        {{ loan.exemplaire.ouvrage.titre }}
                                    {% else %}
                                        —
                                    {% endif %}
                                </td>
                                <td>
                                    {% if loan.exemplaire %}
                                        <span class="badge bg-light text-dark border">{{ loan.exemplaire.cote }}</span>
                                    {% else %}
                                        —
                                    {% endif %}
                                </td>
                                <td>{{ loan.startAt|date('d/m/Y') }}</td>
                                <td>
                                    {{ loan.dueAt|date('d/m/Y') }}
                                    {% if loan.dueAt < date() and not loan.returnedAt %}
                                        <span class="badge bg-danger ms-2">Retard</span>
                                    {% endif %}
                                </td>
                                <td>
                                    {% if loan.status.value == 'en_retard' %}
                                        <span class="badge bg-danger">En retard</span>
                                    {% elseif loan.status.value == 'en_cours' %}
                                        <span class="badge bg-success">En cours</span>
                                    {% elseif loan.status.value == 'retourne' %}
                                        <span class="badge bg-secondary">Rendu</span>
                                    {% else %}
                                        <span class="badge bg-info">{{ loan.status.value|upper }}</span>
                                    {% endif %}
                                </td>
                                <td class="text-end pe-4">
                                    {% if loan.returnedAt %}
                                        {{ loan.returnedAt|date('d/m/Y') }}
                                    {% else %}
                                        <span class="text-muted">—</span>
                                    {% endif %}
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    {% endif %}
</div>

<style>
    .table thead th {
        color: #212529 !important;
        background-color: #e9ecef !important;
        font-weight: 600;
    }
    
    .table-light {
        background-color: #e9ecef !important;
    }
</style>
{% endblock %}