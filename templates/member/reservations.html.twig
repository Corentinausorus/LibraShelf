{% extends 'base.html.twig' %}

{% block title %}Mes réservations{% endblock %}

{% block body %}
<div class="container mt-5">
    <h1>Mes réservations</h1>

    {% if reservations is empty %}
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> Vous n'avez aucune réservation en cours.
        </div>
    {% else %}
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Ouvrage</th>
                    <th>Date de réservation</th>
                    <th>Statut</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for reservation in reservations %}
                <tr>
                    <td>{{ reservation.ouvrage.titre }}</td>
                    <td>{{ reservation.creationDate|date('d/m/Y') }}</td>
                    <td>
                        <span class="badge {{ reservation.statut.badgeClass }}">
                            {{ reservation.statut.label }}
                        </span>
                        
                        {% if reservation.statut.value == 'en_attente' and queuePositions[reservation.id] is defined %}
                            <small class="text-muted">(Position: {{ queuePositions[reservation.id] }})</small>
                        {% endif %}
                    </td>
                    <td>
                        {% if reservation.isActive %}
                            <form method="post" action="{{ path('member_reservation_cancel', {id: reservation.id}) }}" style="display:inline;">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ reservation.id) }}">
                                <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Confirmer l\'annulation ?')">
                                    <i class="bi bi-x-circle"></i> Annuler
                                </button>
                            </form>
                        {% else %}
                            <span class="text-muted">-</span>
                        {% endif %}
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}

    <a href="{{ path('member_ouvrages') }}" class="btn btn-primary">
        <i class="bi bi-arrow-left"></i> Retour au catalogue
    </a>
</div>
{% endblock %}