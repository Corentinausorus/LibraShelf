{% extends 'base.html.twig' %}

{% block title %}Gestion des Emprunts{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row mb-4">
        <div class="col">
            <h1 class="mb-3">
                <i class="bi bi-book-half"></i> Gestion des Emprunts
            </h1>
            <p class="text-muted">Transformez les réservations en emprunts</p>
        </div>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill"></i> {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    {% for message in app.flashes('error') %}
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i> {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    {% for message in app.flashes('info') %}
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            <i class="bi bi-info-circle-fill"></i> {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    {% if reservations is empty %}
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i>
            Aucune réservation active à transformer en emprunt.
        </div>
    {% else %}
        <div class="card shadow-sm">
            <div class="card-header bg-white">
                <h5 class="mb-0">
                    <i class="bi bi-list-check"></i> Réservations actives ({{ reservations|length }})
                </h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="table-light">
                            <tr>
                                <th style="color: #212529;">Ouvrage</th>
                                <th style="color: #212529;">Emprunteur</th>
                                <th style="color: #212529;">Date de création</th>
                                <th style="color: #212529;">Statut</th>
                                <th style="color: #212529;">Email</th>
                                <th style="color: #212529;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for reservation in reservations %}
                            <tr>
                                <td>
                                    <strong>{{ reservation.ouvrage.titre }}</strong><br>
                                    <small class="text-muted">
                                        {% if reservation.ouvrage.auteurs|length > 0 %}
                                            {{ reservation.ouvrage.auteurs|map(a => a.nom)|join(', ') }}
                                        {% else %}
                                            Auteur non renseigné
                                        {% endif %}
                                    </small>
                                </td>
                                <td>{{ reservation.user.nom }}</td>
                                <td>{{ reservation.creationDate|date('d/m/Y H:i') }}</td>
                                <td>
                                    {% set statusColor = 'info' %}
                                    {% if reservation.statut.value == 'disponible' or reservation.statut.value == 'a_recuperer' %}
                                        {% set statusColor = 'success' %}
                                    {% elseif reservation.statut.value == 'en_attente' %}
                                        {% set statusColor = 'warning' %}
                                    {% endif %}
                                    <span class="badge bg-{{ statusColor }}">
                                        {{ reservation.statut.value|upper|replace({'_': ' '}) }}
                                    </span>
                                </td>
                                <td>
                                    <a href="mailto:{{ reservation.user.email }}" class="text-decoration-none">
                                        <i class="bi bi-envelope"></i> {{ reservation.user.email }}
                                    </a>
                                </td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <form method="post" 
                                              action="{{ path('app_emprunt_create', {'id': reservation.id}) }}" 
                                              class="d-inline"
                                              onsubmit="return confirm('Confirmer la création de l\'emprunt pour {{ reservation.user.nom }} ?');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('emprunt_create_' ~ reservation.id) }}">
                                            <button type="submit" class="btn btn-success btn-sm" title="Créer l'emprunt">
                                                <i class="bi bi-check-circle"></i> Créer emprunt
                                            </button>
                                        </form>
                                        
                                        <form method="post" 
                                              action="{{ path('app_emprunt_cancel_reservation', {'id': reservation.id}) }}" 
                                              class="d-inline"
                                              onsubmit="return confirm('Êtes-vous sûr de vouloir annuler cette réservation ?');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('reservation_cancel_' ~ reservation.id) }}">
                                            <button type="submit" class="btn btn-outline-danger btn-sm" title="Annuler la réservation">
                                                <i class="bi bi-x-circle"></i> Annuler
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    {% endif %}
</div>

<style>
    .table th {
        font-weight: 600;
        color: #212529 !important;
    }
    
    .table-light {
        background-color: #e9ecef !important;
    }
    
    .btn-group {
        gap: 0.25rem;
    }
    
    .card {
        border: none;
    }
</style>
{% endblock %}