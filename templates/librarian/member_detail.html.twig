{% extends 'base.html.twig' %}

{% block title %}{{ member.nom }} - Détails{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="mb-4">
        <a href="{{ path('librarian_members') }}" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Retour à la liste
        </a>
    </div>

    <div class="row">
        <div class="col-md-4">
            <div class="card shadow-sm mb-4">
                <div class="card-body text-center">
                    <i class="bi bi-person-circle" style="font-size: 5rem; color: #10b981;"></i>
                    <h3 class="mt-3">{{ member.nom }}</h3>
                    <p class="text-muted">{{ member.email }}</p>
                    <span class="badge bg-success">{{ member.role }}</span>
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-white">
                    <h5 class="mb-0"><i class="bi bi-bookmark-check"></i> Réservations ({{ member.reservations|length }})</h5>
                </div>
                <div class="card-body">
                    {% if member.reservations is empty %}
                        <p class="text-muted">Aucune réservation.</p>
                    {% else %}
                        <ul class="list-group">
                            {% for reservation in member.reservations %}
                            <li class="list-group-item">
                                <strong>{{ reservation.ouvrage.titre }}</strong><br>
                                <small class="text-muted">Créée le {{ reservation.creationDate|date('d/m/Y') }}</small>
                                <span class="badge bg-info float-end">{{ reservation.statut.value }}</span>
                            </li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-header bg-white">
                    <h5 class="mb-0"><i class="bi bi-book"></i> Emprunts ({{ member.emprunts|length }})</h5>
                </div>
                <div class="card-body">
                    {% if member.emprunts is empty %}
                        <p class="text-muted">Aucun emprunt.</p>
                    {% else %}
                        <ul class="list-group">
                            {% for emprunt in member.emprunts %}
                            <li class="list-group-item">
                                <strong>{{ emprunt.exemplaire.ouvrage.titre }}</strong><br>
                                <small class="text-muted">
                                    Du {{ emprunt.startAt|date('d/m/Y') }} au {{ emprunt.dueAt|date('d/m/Y') }}
                                </small>
                                <span class="badge bg-{{ emprunt.status.value == 'en_cours' ? 'success' : 'secondary' }} float-end">
                                    {{ emprunt.status.value }}
                                </span>
                            </li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}