{% extends 'base.html.twig' %}

{% block title %}Gestion des exemplaires{% endblock %}

{% block body %}
<div class="container mt-5">
    <h1><i class="bi bi-book"></i> Gestion des exemplaires</h1>
    <p class="text-muted">Liste complète des exemplaires physiques de la bibliothèque</p>

    <a href="{{ path('librarian_exemplaire_new') }}" class="btn btn-success mb-3">
        <i class="bi bi-plus-circle"></i> Ajouter un exemplaire
    </a>

    {% if exemplaires is empty %}
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> Aucun exemplaire disponible.
        </div>
    {% else %}
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th scope="col">#</th>
                        <th scope="col">Cote</th>
                        <th scope="col">Ouvrage</th>
                        <th scope="col">État</th>
                        <th scope="col">Disponibilité</th>
                        <th scope="col">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for exemplaire in exemplaires %}
                    <tr>
                        <td><strong>{{ exemplaire.id }}</strong></td>
                        <td><code>{{ exemplaire.cote }}</code></td>
                        <td>{{ exemplaire.ouvrage ? exemplaire.ouvrage.titre : 'N/A' }}</td>
                        <td>
                            <span class="badge {{ exemplaire.etat.badgeClass }}">
                                {{ exemplaire.etat.label }}
                            </span>
                        </td>
                        <td>
                            {% if exemplaire.disponible %}
                                <span class="badge bg-success">
                                    <i class="bi bi-check-circle"></i> Disponible
                                </span>
                            {% else %}
                                <span class="badge bg-danger">
                                    <i class="bi bi-x-circle"></i> Emprunté
                                </span>
                            {% endif %}
                        </td>
                        <td>
                            <div class="btn-group" role="group">
                                
                                <form method="post" 
                                      action="{{ path('librarian_exemplaire_delete', {id: exemplaire.id}) }}" 
                                      style="display:inline;"
                                      onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet exemplaire ?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ exemplaire.id) }}">
                                    <button type="submit" 
                                            class="btn btn-sm btn-danger" 
                                            title="Supprimer">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <div class="mt-3">
            <p class="text-muted">
                <i class="bi bi-info-circle"></i> 
                <strong>{{ exemplaires|length }}</strong> exemplaire(s) au total
            </p>
        </div>
    {% endif %}
</div>
{% endblock %}